        {
            "link": "https://mangabuff.ru/manga/kak-nasytit-dyavola/1/1",
            "title": "Том 1 . Глава 1"
        },
        {
             "link": "https://mangabuff.ru/manga/kak-nasytit-dyavola/1/2",
            "title": "Том 1 . Глава 2"
        }
                ]
            }
        },
        {
            "proc": "chapter_complete",
