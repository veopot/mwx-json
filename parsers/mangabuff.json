{
    "id": 57843,
    "version": 9,
    "title": "Manga Buff",
    "host": "https://mangabuff.ru",
    "public_link": "https://mangabuff.ru/manga",
    "folder": "mangabuff",
    "name": "mangabuff",
    "chapters_order": true,
    "language": "ru",
    "encoding": "utf-8",

    "icon_link": "https://raw.githubusercontent.com/veopot/mwx-json/main/img/mangabuff.png",
    "self_link": "https://raw.githubusercontent.com/veopot/mwx-json/main/parsers/mangabuff.json",
    "self_link2": "https://fant.my1.ru/mwparser/mwx/json/mangabuff.json",
    "catalog_link": "https://raw.githubusercontent.com/veopot/mwx-json/main/catalogs/mangabuff.zip",
    "file_type": "sqlite",
    "author": {
        "name": "Veopot",
        "email": "fant-net@ya.ru"
    },
    
	

	
    "manga_search_complete": {
       "headers": {
			"cookie": "remember_web_%3D",
			"Accept": "*/*",
            "Referer": "https://mangabuff.ru/",
            "User-Agent": "MangaWatcherX" 
			},
        "search_link": "https://mangabuff.ru/search?q=$query$",
        "query_type": "GET",
        "add_manga": {
            "start": "<div class=\"main\">",
            "end": "class=\"footer\">",
            "next": "class=\"cards__item\"",
            "link": {
                "before": "class=\"cards__img\"",
                "token1": "href=\"",
                "token2": "\""
            },

            "title": {
                "token1": "class=\"cards__name\">",
                "token2": "</div>"
            },
            "uniq": {
                "token1": "class=\"cards__name\">",
                "token2": "</div>"
            },
			
            "cover": {
                "token1": "background-image: url('/x180/",
                "token2": "')\">",
                "replace": {
                    "prefix": "https://mangabuff.ru"
                }
            },
            
            "summary": {
                "token1": "class=\"cards__info\">",
                "token2": "</div>"
            }
        }
    },
    "manga_list_complete": {
         "headers": {
			"cookie": "remember_web_%3D",
			"Accept": "*/*",
            "Referer": "https://mangabuff.ru/",
            "User-Agent": "MangaWatcherX" 
			},
        "iterator": {
            "base_url": "https://mangabuff.ru/manga?page=",
            "append_nums": {
                "from": 1,
                "to": 228
            }
        },
        "add_manga": {
            "start": "<div class=\"cards\">",
            "end": "<ul class=\"pagination\">",
            "next": "class=\"cards__item\"",
            "link": {
                "before": "class=\"cards__img\"",
                "token1": "href=\"",
                "token2": "\""
            },

            "title": {
                "token1": "class=\"cards__name\">",
                "token2": "</div>"
            },
            "uniq": {
                "token1": "class=\"cards__name\">",
                "token2": "</div>"
            }
        },
	    
        "rating_auto_inc": {
            "start": "40000",
            "inc": -1
        }
    },
    "manga_complete": {
		
        "headers": {
			"cookie": "remember_web_%3D",
			"Accept": "*/*",
            "Referer": "https://mangabuff.ru/",
            "User-Agent": "MangaWatcherX" 
			},
        
        "title": {
            "token1": "<title>",
            "token2": "</title>",
            "replace":[
			{ "match": "- Манхва читать онлайн", "text": ""},
			{ "match": "- OEL-манга читать онлайн", "text": ""},
			{ "match": "- Сингл читать онлайн", "text": ""},
			{ "match": "- Руманга читать онлайн", "text": ""},
			{ "match": "- Маньхуа читать онлайн", "text": ""},
			{ "match": "- Комикс западный читать онлайн", "text": ""},
			{ "match": "- Манга читать онлайн", "text": ""}
			
			
			]
            },
        
        "uniq": {
            "token1": "<meta property=\"og:url\" content=\"https://mangabuff.ru/manga/",
            "token2": "\">"
        },
        "cover": {
			"skip": "<div class=\"manga__img\">",
            "token1": " src=\"",
            "token2": "\"",
            "replace": [
                {
                    "prefix": "https://mangabuff.ru"
                },
                {
                    "match": "u002F",
                    "text": "/"
                }
            ]
        },
        "summary": {
            "token1": "class=\"manga__description\">",
            "token2": "</div>",
            "replace": [
                {
                    "match": "u003Cp",
                    "text": ""
                },
                {
                    "match": "u003E",
                    "text": ""
                },
                {
                    "match": "u003C",
                    "text": ""
                },
                {
                    "match": "<.*?>",
                    "text": ""
                },
                {
                    "match": "u002Fp",
                    "text": ""
                },
                {
                    "match": "&quot;",
                    "text": "'"
                }
            ]
        },
       
        "status": {
            "complete": {
                "start": "class=\"manga__middle\"",
                "end": "class=\"manga__name\"",
                "values": ["Закончен", "Переведена","Завершен","Сингл"]
            },
            "ongoing": {
                "start": "class=\"manga__middle\"",
                "end": "class=\"manga__name\"",
                "value": "Продолжается"
            }
        },
        
        "add_tags": {
            "start": "class=\"manga__middle\"",
            "end": "class=\"manga__description\">",
            "token1": "class=\"tags__item\">",
            "token2": "</"
        },
        "is_mature": {
            "values": ["Сэйнэн", "Эротика", "Юри", "Яой",">18+</div>",    "class=\"tags__item tags__item--warning\">" ]
        },
		
		"need_auth": [
			"залогиненным",
			">18+</div>",
			"хентай"
		],
        
		
		"chapters_from_page": {
            "after": "property=\"og:url\"",
            "token1": "content=\"",
            "token2": "\"",
            "replace": { "sufix": "/reader-chapters"}
        },
    "add_chapter": {
    "headers": {
        "Accept": "*/*",
        "Referer": "%%url%%"
    },
    "start": "{\"content",
    "end": "\"}",
    "next": "<a href=",
	
	
    "link": {
		
		"after": "\"https",
        "token1": "https:\\/\\/mangabuff.ru\\/",
        "token2": "\\\"",
        "replace": [
            { "match": "\\\\", "text": "" },
            { "prefix": "https://mangabuff.ru/" }
        ]
    },
    "uniq": {
		"after": "\"https",
        "token1": "mangabuff.ru\\/",
        "token2": "\\\"",
        "replace":[ 
		{ "match": "\\/", "text": "_" },
		 { "match": "\\\\", "text": "" }
		]
    },
    "title": {
		"after": "\"https",
        "token1": "\\\">",
        "token2": "<\\/a>",
        "replace": [
		     { "clear_escape": true },
            { "match": "\\\\n", "text": " " },
            { "match": "<.*?>", "text": "" },
            { "match": "\\\\", "text": "" },
            { "match": "   ", "text": " " },
            { "match": "  ", "text": " " },
            { "match": "&quot;", "text": "\"" },
            { "match": "\u2014", "text": "-" }
        ]
    }
}







   

   },
    "chapter_complete": {
         "headers": {
			"cookie": "remember_web_%3D",
			"Accept": "*/*",
            "Referer": "https://mangabuff.ru/",
            "User-Agent": "MangaWatcherX" 
			},
        "add_images": {
            "start": "class=\"reader__pages\">",
            "token1": "src=\"",
            "token2": "\"",
            "end": "<div class=\"reader__footer\">"
        }
    },
    "test": [
        {
            "proc": "manga_list_complete",
            "assert": {
                "mangas": [
                    {
                        "uniq": "Выбери_меня!",
                        "link": "https://mangabuff.ru/manga/vyberi-menya",
                        "title": "Выбери меня!"
                    }
                ],
                "mangas_count": ">=20"
            }
        },
        {
