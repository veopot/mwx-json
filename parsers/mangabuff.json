        {"image": "https://c3.mangabuff.ru/chapters/agmaleul-baebullineun-beob/1/1/1.jpeg"},
        {"image": "https://c3.mangabuff.ru/chapters/agmaleul-baebullineun-beob/1/1/2.jpeg"},
        {"image": "https://c3.mangabuff.ru/chapters/agmaleul-baebullineun-beob/1/1/3.jpeg"}
                ]
            }
        }
    ]
}