	"catalog_link": "https://raw.githubusercontent.com/veopot/mwx-json/main/catalogs/desu.zip",
    "file_type": "sqlite",
		
	"manga_search_complete": {
	    
		"search_link": "https://desu.uno/manga/api/?limit=10&page=$page$&search=$query$",
		"query_type": "GET",
		"headers": { "cookie": "xf_user=11072%2C0a7dd015ace06f09a98b213413117b286be3214b" }, 
		
		"add_manga":  {
		    "start": "response",
			"end": "]",
            "next": "{\"i",
			
			"link":  { "token1": "url\":\"", "token2": "\"" },
			
			"cover":  { "skip": "image\":{", "token1": "original\":\"", "token2": "\"" },
            
			"title": { "token1": "russian\":\"", "token2": "\"" },
			
			"summary":{  "token1":"description\":\"", "token2": "\"" }
			
			}
		
		},
	
		
		
	"manga_list_complete": {
		"iterator": {
			"base_url": "https://desu.uno/manga/?order_by=popular&page=",
			"append_nums": { "from": 1, "to": 240 }
		},
		
		
		"add_manga": {
			"next": "<div style=\"margin-left: 115px;\">",
			
			"link":  { "after": "<h3><a", "token1": "href=\"", "token2": "\"",
			"replace": { "prefix": "https://desu.uno/" }
			},
			
			
			"uniq": { "after": "<h3><a", "token1": "href=\"manga/", "token2": "\"",},
			"title": { "after": "<h3><a", "token1": "title=\"", "token2": "\"",},
		},	 
		"rating_auto_inc": {
			"start": "30000",
			"inc": -1
		}
	},

	"manga_complete": 
		{
		"headers": { "cookie": "xf_user=11072%2C0a7dd015ace06f09a98b213413117b286be3214b" }, 
			"title":      { "after": "meta name=\"twitter:title\"", "token1":"content=\"", "token2": "\"",
            "replace": [
                {
                    "clear_escape": true
                },
                {
                    "match": "\\\\",
                    "text": ""
                }
            ] },
			"uniq":       { "skip": "<span class=\"rus-name\"", "token1":"\">", "token2": "</" },
			
			
			"status":      { 
				"complete": [ "Сингл", "вышло", ">завершён<" ], 
				"licensed": "<span class=\"b-anime_status_tag copyright\">Закрыт",
				"ongoing":[ "выходит", ">продолжается<"]  
			
			},
			
			 "is_mature": { "values": ["Сэйнэн", "Эротика", "Юри", "Яой","Эта манга предназначена для взрослой аудитории",">Контент 18+<" ]  },
		
		
			"summary":     { "skip": "<div class=\"prgrph\"", "token1": ">", "token2": "<div class=\"shade\">",

				"replace": [

				    { "match": "&quot;", "text": "'" },

					{ "match": "<.*?>", "text": " " }

				] },
			"read_dir":    { "right_to_left": "class=\"valuev\">Манга", "left_to_right": "class=\"valuev\">Манхва" },
			
			"author":      { "skip": "class=\"key\">Автор", "token1": "<ul class=\"translators\" style=\"display:inline;\">", "token2": "</ul>",
			"replace": { "match": "<.*?>", "text": "" } },
			
			"cover":       { "skip": "<div class=\"c-poster", "token1": "/data/manga/covers", "token2": "\"","replace": {"prefix" : "https://static.desu.uno/data/manga/covers" } },
			
			"add_genre": { "after": "href=\"manga/?genre", "token1": "\">", "token2": "</a>",
			"replace": { "match": "<.*>", "text": "" } },
			
			"chapters_from_page": { "skip": "pageUrl:", "token1": "'manga_", "token2": "')",
			"replace": [

				    { "prefix": "https://desu.uno/api/manga/"  },
                    { "sufix": "/chapters"  }

				]

            },
			
			
			"add_chapter": {
				"start": "\"chapters\"",
				"next":  "\"id\"",
				"end": "]}",
				"link":  { "token1": "\"id\":", "token2": ",","replace": {"prefix" : "%%url%%/" } },
				
				
				"title":  { "token1": "\"vol", "token2": "\"publish",
				"replace": [
				{ "match" : "ume\":\"", "text": "Том " },
				{ "match" : "\",\"number\":\"", "text": " Глава " }, 
				{ "match" : "\",\"title\":null,", "text": " " },
				{ "match" : "\",\"title\":\"", "text": " " }, 
				{ "match" : "\",", "text": " " } 
				
				]
				},
				
				"uniq":  { "token1": "\"volume\":\"", "token2": "\",\"title",
				"replace": { "match" : "\",\"number\":\"", "text": "-" } }
			}
		},
	
	"chapter_complete": {
		"headers": { "cookie": "xf_user=11072%2C0a7dd015ace06f09a98b213413117b286be3214b" }, 
		"images": true,
		"add_pages": {
			"start": "\"pages\"",
			"token1": "\"url\":\"",
			"token2": "\"",
			"end": "}]"
		}
	},

