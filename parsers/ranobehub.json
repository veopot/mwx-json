   "public_link":"https://ranobehub.org",
   "folder":"ranobehub",
   "name":"ranobehub",
   "language":"ru",
   "encoding":"utf-8",
   "chapters_order":true,
   "icon_link":"https://raw.githubusercontent.com/veopot/mwx-json/main/img/ranobehub.png",
   
    "self_link": "https://raw.githubusercontent.com/veopot/mwx-json/main/parsers/ranobehub.json",
    "self_link2": "https://fant.my1.ru/mwparser/mwx/json/ranobehub.json",
    "catalog_link": "https://raw.githubusercontent.com/veopot/mwx-json/main/catalogs/ranobehub.zip",
    "file_type": "sqlite",
   "author":{
       "name":"MWX and Hikkun",
      "email":"fant-net@ya.ru"
   },
   
   "manga_search_complete": {
	   "headers": {
			"cookie": "rh_session=eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyIjp7ImlkIjo1MTY4LCJuYW1lIjoi0JLQu9Cw0LTQuNC80LjRgCDQotC-0L_QvtC10LIiLCJlbWFpbCI6ImZhbnQtbmV0QHlhLnJ1Iiwicm9sZXMiOltdfSwiaWF0IjoxNzg3OTkzNDI4LCJleHAiOjE5NDU2NzM0Mjh9.iiKmvMvVvdvJyFWSbPutfAIrXhChVRWwhzkrIl0-jus"
		},
	   
        "search_link": "https://ranobehub.org/api/search?q=$query$",
        "query_type": "GET",
        "add_manga":{
			"start": "\"books\"",
            "end": "\"entities\"",
			"next":"{\"id\"",
			
         "title":{
            "token1":"\"title\":\"",
            "token2":"\""
         },
         "link":{
			"before":"\"title\":\"",
		    "token1":"id\":",
            "token2":"\",",
			"replace" : [{ "match" : ",\"slug\":\"", "text" : "-" },
			             { "prefix":"https://ranobehub.org/ranobe/" }
						 ]
         },
		 "uniq":{
            "token1":"\"slug\":\"",
            "token2":"\"",
			"replace" : { "match" : "\\\\", "text" : "" }
         },
		 
            "cover": {
                "token1": "\"posterUrl\":\"",
                "token2": "\"",
				"replace":{ "prefix":"https://ranobehub.org" }
            },
            
            "summary": {
                "token1": "\"description\":\"",
                "token2": "\",",
                "replace": [
                    {"match": "<div class=\"FicTable_Genres\">", "text": "&nbsp;&nbsp;" },
					{ "match":"<.*?>", "text":""}
                ]
            }
        }
    },
   
   
   "manga_list_complete":{
	   "headers": {
			"cookie": "rh_session=eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyIjp7ImlkIjo1MTY4LCJuYW1lIjoi0JLQu9Cw0LTQuNC80LjRgCDQotC-0L_QvtC10LIiLCJlbWFpbCI6ImZhbnQtbmV0QHlhLnJ1Iiwicm9sZXMiOltdfSwiaWF0IjoxNzg3OTkzNDI4LCJleHAiOjE5NDU2NzM0Mjh9.iiKmvMvVvdvJyFWSbPutfAIrXhChVRWwhzkrIl0-jus"
		},

      "iterator":{
         "base_url":"https://ranobehub.org/api/catalog?sort=popular&page=",
		 
		 "append_nums": { "from": 1, "to": 131, "step": 1}
         
      },
      "add_manga":{
         "next":"{\"id\"",
         "title":{
            "token1":"\"title\":\"",
            "token2":"\""
         },
         "link":{
			"before":"\"title\":\"",
		    "token1":"id\":",
            "token2":"\",",
			"replace" : [{ "match" : ",\"slug\":\"", "text" : "-" },
			             { "prefix":"https://ranobehub.org/ranobe/" }
						 ]
         },
		 "uniq":{
            "token1":"\"slug\":\"",
            "token2":"\"",
			"replace" : { "match" : "\\\\", "text" : "" }
         }
     
      }
   },
   
   
   
   "manga_complete":{

     "content_type": {
			"default": "light_novels"
		},

      "title":{
         "skip":"property=\"og:title\"",
         "token1":"content=\"",
         "token2":"\"",
			"replace": [
			    { "clear_escape": true },
				{"match": "\u2013","text": "-"},
		        {"match": "%2F","text": "/"},
				{"match": "%3F","text": "?"},
				{"match": "%3D","text": "="},
				{"match": "%26","text": "&"},
				{ "match": "Ранобэ", "text": "" },
				{"match":"<.*?>","text":"&"}
				    ]
		},
	
      "uniq":{
          "after":"[[\"book\",\"",
         "token1":",\"",
         "token2":"\""
      },
	  
      "cover":{
         "after":"posters\\\":[{\\\"id\\\":",
         "token1":"\\\"url\\\":\\\"",
         "token2":"\\\",", 
		 "replace": [
		        {"match": "%2F","text": "/"},
				{"match": "%3F","text": "?"},
				{"match": "%3D","text": "="},
				{"match": "%26","text": "&"},
				{"match": "\\\\u0026","text": "&"},
				{"match":"<.*?>","text":"&"},
                { "prefix": "https://ranobehub.org"}
]
        },

      "author":{
         "after":"href=\"/author/",
         "token1":"\">",
         "token2":"</div>",
         "replace": [
		        {"match": "</span></span>","text": " "},
				{  "match":"<.*?>",  "text":"" }
				 ]
		
      },
      "summary":{
         "after":"<meta name=\"description\"",
         "token1":"content=\"",
         "token2":"\"/>",
         "replace":{
            "match":"<.*?>",
            "text":" "
         }
      },
	  
	  "status":    { 
		"complete": "status=2\">Завершено</a>",
		"ongoing": "status=1\">В процессе</a>", 
		"unknown": "status=3\">Заморожено</a>"
		    },
		
		
		
		
		
		
		"add_tag": {
			"after":"href=\"/tag/",
			"token1": "\">",
			"token2": "</a>"
		},
			
			
      "is_mature":{
         "values":[
           "Для взрослых",
           ">место для рекламы<",
           ">место для рекламы<",
           ">место для рекламы<"
         ]
      },
	  


		"chapters_from_page": {
            "token1": "aria-current=\"page\" data-book-transition-id=\"",
            "token2": "\"",
            "replace":[
		    { "prefix": "https://ranobehub.org/api/books/" },
			{"sufix": "/chapters?limit=250&offset=%%iterator_num%%"  }
		        ],
            "iterator": {
                "base_url": "",
                "append_nums": {
                    "from": 0,"step": 250
                }
            } 
		},
		


      "add_chapter":{
         "start":"\"items\"",
		 
         "next":"\"id\":",
         "link":{
			"before": "\"bookId\"", 
            "token1":"id\":",
            "token2":",",
			"replace": { "prefix": "https://ranobehub.org/api/chapters/"}
         },
		 "uniq":{
            "token1":"\"vol",
            "token2":",\"title\"",
			"replace" : [
			{ "match" : "ume\":", "text" : "Tom_" },
			{ "match" : ",\"number\":", "text" : "_number_id_" },
			{ "match" : "\\\\", "text" : "" }
			]
			
		    },
			
			"title":{
            "token1":"\"vol",
            "token2":"\",\"hasImages\"",
			"replace" : [
			{ "match" : "ume\":", "text" : "Том " },
			{ "match" : ",\"number\":(.*),", "text" : "." },
			{ "match" : "\"title\":\"", "text" : " " },
			{ "match" : "\\\\", "text" : "" }
			]
			
		    }
			
	}
},
   
   
  
